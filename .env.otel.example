

# Optional OTEL: inject these into the process/container environment.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=foxtrot-demo
# OTEL_SDK_DISABLED=true

# System agent: compose.observability.yml (one agent per Linux application host).
OTEL_APPLICATION_ID=goods
SERVED_BY=aws
OTEL_HOST_NAME=goods-aws-01
# Raw collector ingest token. Keep it in the deployment secret store.
OTEL_INGEST_TOKEN=
