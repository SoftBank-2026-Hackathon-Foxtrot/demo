# Inject into app containers; do not run a hostmetrics agent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Authorization=Bearer%20<ingest-token>; keep the real value in a secret store.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SYSTEM_METRICS=container
OTEL_APPLICATION_ID=goods
# Must match the platform-owned deployment record, not a display name.
OTEL_OWNER_ID=
OTEL_DEPLOYMENT_ID=
SERVED_BY=onprem
# Provisioner sets api/worker and container/app-instance according to the runtime.
# OTEL_APP_ROLE=api
# OTEL_NETWORK_SCOPE=container
# OTEL_SDK_DISABLED=true
